<idea-plugin>
    <id>br.com.weslleycampos.simpanel</id>
    <name>iOS Simulator</name>
    <vendor>Weslley Campos</vendor>
    <!-- The description comes from plugin/description.md at build time. -->

    <depends>com.intellij.modules.platform</depends>

    <resource-bundle>messages.SimPanelBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="iOS Simulator" anchor="right" os="mac" icon="/icons/toolWindow.svg"
                    factoryClass="br.com.weslleycampos.simpanel.ui.SimulatorToolWindowFactory"/>
        <notificationGroup id="iOS Simulator" displayType="BALLOON" key="notification.group"/>
        <projectCloseHandler implementation="br.com.weslleycampos.simpanel.shutdown.ShutDownOnClose"/>
        <advancedSetting id="simpanel.shutDownOnClose" default="Ask" groupKey="advanced.settings.group"
                         enumClass="br.com.weslleycampos.simpanel.shutdown.ShutDownChoice"/>
        <advancedSetting id="simpanel.maxFps" default="60" groupKey="advanced.settings.group"/>
        <advancedSetting id="simpanel.jpegQuality" default="70" groupKey="advanced.settings.group"/>
        <advancedSetting id="simpanel.deviceHubOnRun" default="Hide" groupKey="advanced.settings.group"
                         enumClass="br.com.weslleycampos.simpanel.runs.DeviceHubOnRun"/>
    </extensions>

    <projectListeners>
        <listener class="br.com.weslleycampos.simpanel.runs.SimulatorRunListener"
                  topic="com.intellij.execution.ExecutionListener"/>
    </projectListeners>
</idea-plugin>
